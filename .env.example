# Copy to .env.local and fill in. Never commit real values.
# Values for local dev come from `npx supabase start` / `npx supabase status`.

# --- Public (shipped to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server only (never prefix with NEXT_PUBLIC_) ---
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional receipt-parser effort override: low | medium | high | xhigh | max (model default if empty)
RECEIPT_PARSER_EFFORT=

# Used by `npm run db:types` against the hosted project
SUPABASE_PROJECT_ID=

# --- Splitwise OAuth (optional; the integration is hidden until all three are set) ---
# Register an app at https://secure.splitwise.com/apps with callback URL
# http://localhost:3000/api/splitwise/callback (production: https://<domain>/api/splitwise/callback)
SPLITWISE_CLIENT_ID=
SPLITWISE_CLIENT_SECRET=
# openssl rand -base64 32
SPLITWISE_TOKEN_KEY=

# --- Google OAuth (read by the Supabase CLI, NOT Next.js) ---
# Put these in supabase/.env (gitignored), then `npx supabase stop && npx supabase start`.
# Authorized redirect URI in Google Cloud: http://127.0.0.1:54321/auth/v1/callback
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
