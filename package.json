{
  "name": "splitlens",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run typecheck && npm run test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "node scripts/gen-db-types.mjs",
    "db:types:local": "node scripts/gen-db-types.mjs --local",
    "test:db": "supabase test db",
    "eval:receipts": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/eval-receipts.mts",
    "check:bundle": "node scripts/check-client-bundle.mjs",
    "db:push": "supabase db push"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@dnd-kit/core": "^6.3.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.52.0",
    "next": "15.5.27",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.7.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.3",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.9",
    "supabase": "^2.119.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.12"
  }
}
